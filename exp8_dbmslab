-- 1. Create EMP Table
CREATE TABLE EMP (
    EMPNO NUMBER(6) PRIMARY KEY,
    ENAME VARCHAR2(20) NOT NULL,
    JOB VARCHAR2(10) NOT NULL,
    DEPTNO NUMBER(3) UNIQUE,
    SAL NUMBER(7,2),
    CONSTRAINT emp_empno_check CHECK (EMPNO > 100)
);

-- 5. Create DEPARTMENT Table
CREATE TABLE DEPARTMENT (
    DEPTNO NUMBER(3) PRIMARY KEY,
    DNAME VARCHAR2(20),
    LOCATION VARCHAR2(20) NULL
);

-- 6. Add Foreign Key Constraint to EMP Table
ALTER TABLE EMP ADD CONSTRAINT emp_deptno_fk FOREIGN KEY (DEPTNO) REFERENCES DEPARTMENT(DEPTNO);

-- 7. Create MANAGER Table
CREATE TABLE MANAGER (
    MGRNO NUMBER(6) PRIMARY KEY,
    MGRNAME VARCHAR2(20) NULL
);

-- 8. Add Foreign Key Constraint to EMP Table
ALTER TABLE EMP ADD MGRNO NUMBER(6);
ALTER TABLE EMP ADD CONSTRAINT emp_mgrno_fk FOREIGN KEY (MGRNO) REFERENCES MANAGER(MGRNO);

-- 9. Create SALARY_HISTORY Table
CREATE TABLE SALARY_HISTORY (
    ID NUMBER(6) PRIMARY KEY,
    EMPNO NUMBER(6),
    SALARY NUMBER(7,2),
    EFFECTIVE_DATE DATE,
    CONSTRAINT salary_emp_fk FOREIGN KEY (EMPNO) REFERENCES EMP(EMPNO),
    CONSTRAINT unique_emp_effective UNIQUE (EMPNO, EFFECTIVE_DATE),
    CONSTRAINT salary_check CHECK (SALARY >= 0)
);

-- 12. Create EMPLOYEE_BENEFITS Table
CREATE TABLE EMPLOYEE_BENEFITS (
    EMPNO NUMBER(6),
    BENEFITS VARCHAR2(50) NULL,
    CONSTRAINT benefits_emp_fk FOREIGN KEY (EMPNO) REFERENCES EMP(EMPNO)
);

