-- 15. Query to retrieve Employee Names with Department Details
SELECT E.ENAME, D.DNAME, D.LOCATION FROM EMP E JOIN DEPARTMENT D ON E.DEPTNO = D.DEPTNO;

-- 16. Increase Salary by 10% for Employees in Department 10
UPDATE EMP SET SAL = SAL * 1.10 WHERE DEPTNO = 10;

-- 17. Delete a Department Only If No Employees Exist
DELETE FROM DEPARTMENT WHERE DEPTNO = 30 AND NOT EXISTS (SELECT 1 FROM EMP WHERE DEPTNO = 30);

-- 18. Retrieve Salary History of an Employee Sorted by Effective Date Descending
SELECT * FROM SALARY_HISTORY WHERE EMPNO = 101 ORDER BY EFFECTIVE_DATE DESC;

-- 19. Retrieve Managers with Employees
SELECT M.MGRNAME, E.ENAME FROM EMP E JOIN MANAGER M ON E.MGRNO = M.MGRNO;

-- 20. Retrieve Employees Without Benefits
SELECT E.ENAME FROM EMP E LEFT JOIN EMPLOYEE_BENEFITS B ON E.EMPNO = B.EMPNO WHERE B.BENEFITS IS NULL;
